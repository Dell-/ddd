{
    "name": "dell/ddd",
    "description": "Lightweight PHP framework core: XML configured DI container, routing, request handling",
    "type": "project",
    "keywords": ["project"],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-libxml": "*",
        "monolog/monolog": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "app/Core/",
            "Application\\": "app/Application/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    }
}
