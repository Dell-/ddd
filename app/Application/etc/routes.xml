<?xml version="1.0" encoding="UTF-8"?>
<!-- trailing-slash: redirect (to the configured form) | strict (404) | ignore (both forms); per route too -->
<routes trailing-slash="redirect" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Core/Route/etc/routes.xsd">
    <route name="home" method="GET" path="/" action="Application\Action\Http\Index"/>
    <command name="hello" action="Application\Action\Cli\Hello"/>
</routes>
